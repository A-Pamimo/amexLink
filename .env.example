PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox             # sandbox | development | production
PLAID_COUNTRY_CODES=US,CA

STORAGE=sqlite                # sqlite | libsql | postgres
DB_PATH=data/amexlens.sqlite  # sqlite only
DATABASE_URL=                 # libsql / postgres only

AUTH_MODE=none                # none | password | passkey
AUTH_PASSWORD=                # required when AUTH_MODE=password

# 32+ char secret. Generate with: openssl rand -base64 48
# Used for at-rest encryption of Plaid access tokens AND HMAC of session cookies.
# Rotating this invalidates every linked card and every active session.
APP_SECRET=

# auto | true | false. "auto" sets the Secure cookie flag when the request is HTTPS.
COOKIE_SECURE=auto

# Comma-separated list of additional origins allowed for state-changing requests.
# Same-host origins are always allowed; only set this if a reverse proxy serves
# the app under a different hostname.
CSRF_ALLOWED_ORIGINS=
