PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox             # sandbox | development | production
PLAID_COUNTRY_CODES=US,CA

STORAGE=sqlite                # sqlite | libsql | postgres
DB_PATH=data/amexlens.sqlite  # sqlite only
DATABASE_URL=                 # libsql / postgres only

AUTH_MODE=none                # none | password | passkey
AUTH_PASSWORD=                # required when AUTH_MODE=password

# 32 random bytes, base64. Generate: npm run key:generate. Required at server start. Keep OUT of data/ and backups.
TOKEN_ENCRYPTION_KEY=
# Alternative: path to a 0600 file holding the base64 key (or 32 raw bytes), outside data/.
# TOKEN_ENCRYPTION_KEY_FILE=/etc/amexlens/data.key
