PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox             # sandbox | development | production
PLAID_COUNTRY_CODES=CA        # default CA (SECURITY.md 3.5). Add US only for a US-issued card.

STORAGE=sqlite                # sqlite | libsql | postgres
DB_PATH=data/amexlens.sqlite  # sqlite only
DATABASE_URL=                 # libsql / postgres only

# --- WP2: auth ---
# required (default) | none. `none` is a local-sandbox footgun: every route is open. Refused in production.
AUTH_MODE=required
# Exact browser origin (scheme://host[:port], no path). CSRF Origin check + WebAuthn RP origin. https in production.
APP_ORIGIN=http://localhost:3000
# >= 32 random chars. Only consulted while NO sign-in factor is enrolled (first-run setup on /login). Rotate afterwards.
AUTH_SETUP_TOKEN=
# 1 = cookie named amexlens_session without the Secure flag, for plain-http LAN testing only. Refused in production.
COOKIE_INSECURE_DEV=0

# 32 random bytes, base64. Generate: npm run key:generate. Required at server start. Keep OUT of data/ and backups.
TOKEN_ENCRYPTION_KEY=
# Alternative: path to a 0600 file holding the base64 key (or 32 raw bytes), outside data/.
# TOKEN_ENCRYPTION_KEY_FILE=/etc/amexlens/data.key

# --- WP3: backups ---
# age public key the backups are encrypted to (age-keygen -o amexlens-backup.key; copy the "public key:" line).
# The private key (identity) must NOT live on this host or under data/.
BACKUP_AGE_RECIPIENT=
# Path to the age identity file, only on the machine where you run `npm run restore:check`. Never on the server.
AGE_IDENTITY_FILE=

# --- WP4: cron ---
# Bearer secret for headless sync (npm run sync -> POST /api/plaid/sync). Min 32 chars. Generate: openssl rand -base64 32
# Optional; leave empty to disable cron auth. Never reuse the interactive login or the data key.
CRON_SECRET=

# --- WP5a: headers ---
ENABLE_HSTS=0                 # set 1 only behind HTTPS

# --- WP6b: link ---
# Exact OAuth redirect URI registered in the Plaid dashboard (Developers > API > Allowed redirect URIs).
# Needed only for OAuth institutions (mostly US issuers). Absolute http(s) URL, no query or fragment;
# production must be https. Leave empty to omit `redirect_uri` from Link tokens.
PLAID_REDIRECT_URI=http://localhost:3000/plaid/oauth
